@PaperV.Host.paired_factor_assignment : ∀ {E : Type u_1} {V : Type u_2} {H : Type u_3} [inst : Fintype E]
  [DecidableEq E] [Fintype V] [DecidableEq V] [Fintype H] [inst_5 : DecidableEq H] {k : ℕ} (ends : E → Finset V)
  (factor : E → Fin k) (L : E → Finset H),
  (∀ (e f : E), e ≠ f → factor e = factor f → Disjoint (ends e) (ends f)) →
    ∀ (S : Finset (Fin k)) (ι ι' : Fin k → H),
      Function.Injective ι →
        Set.InjOn ι' ↑Sᶜ →
          (∀ f ∉ S, ∀ (g : Fin k), ι' f ≠ ι g) →
            ∃ c, PaperV.Host.ProperOn ends L {e | ¬PaperV.PairedFactors.Uncovered factor L S ι ι' e} c
'PaperV.Host.paired_factor_assignment' depends on axioms: [propext, Classical.choice, Quot.sound]
@PaperV.Host.exists_paired_host_completion : ∀ {E : Type u_1} {V : Type u_2} {H : Type u_3} [inst : Fintype E]
  [DecidableEq E] [Fintype V] [DecidableEq V] [inst_4 : Fintype H] [inst_5 : DecidableEq H] (k q s : ℕ),
  1 ≤ k →
    2 ≤ q →
      s ≤ k →
        2 * k - s ≤ q →
          Fintype.card H = q →
            ∀ (ends : E → Finset V) (factor : E → Fin k) (L : E → Finset H) (β : E → ℚ),
              (∀ (e : E), 0 ≤ β e) →
                (∀ (e f : E), e ≠ f → factor e = factor f → Disjoint (ends e) (ends f)) →
                  ∃ S ι ι' c,
                    S.card = s ∧
                      Function.Injective ι ∧
                        Set.InjOn ι' ↑Sᶜ ∧
                          (∀ f ∉ S, ∀ (g : Fin k), ι' f ≠ ι g) ∧
                            PaperV.Host.ProperOn ends L {e | ¬PaperV.PairedFactors.Uncovered factor L S ι ι' e} c ∧
                              ∑ e with (PaperV.PairedFactors.Uncovered factor L S ι ι') e, β e ≤
                                ↑s / (↑k * ↑q) * ∑ e, β e * ↑(PaperV.PairedFactors.bad q L e) +
                                  (↑k - ↑s) / (↑k * ↑q * (↑q - 1)) *
                                    ∑ e,
                                      β e * ↑(PaperV.PairedFactors.bad q L e) * (↑(PaperV.PairedFactors.bad q L e) - 1)
'PaperV.Host.exists_paired_host_completion' depends on axioms: [propext, Classical.choice, Quot.sound]
@PaperV.Host.empty_factor_completion : ∀ {E : Type u_1} {V : Type u_2} {H : Type u_3} [inst : Fintype E]
  [inst_1 : DecidableEq E] [Fintype V] [DecidableEq V] [Fintype H] [inst_5 : DecidableEq H] (ends : E → Finset V)
  (L : E → Finset H) (factor : E → Fin 0),
  ∃ c, PaperV.Host.ProperOn ends L Finset.univ c ∧ Finset.image (fun e => (e, c e)) Finset.univ = ∅
'PaperV.Host.empty_factor_completion' depends on axioms: [propext, Classical.choice, Quot.sound]
