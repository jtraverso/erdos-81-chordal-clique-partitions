    "content": "\n\\max\\left\\{\n\\sum_{T\\in\\mathcal T}w_T:\nw_T\\ge0,\\ \n\\sum_{T\\ni e}w_T\\le r_e\n\\text{ for every }e\\in E\n\\right\\}\n",
